{
  "mcpServers": {
    "inkscape": {
      "command": "python",
      "args": [
        "-m",
        "inkmcp.inkscape_mcp_server"
      ]
    },
    "inkscape-windows-bat": {
      "command": "cmd.exe",
      "args": [
        "/c",
        "inkmcp/run_inkscape_mcp.bat"
      ]
    },
    "inkscape-windows-ps1": {
      "command": "powershell.exe",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "inkmcp/run_inkscape_mcp.ps1"
      ]
    },
    "inkscape-unix": {
      "command": "bash",
      "args": [
        "inkmcp/run_inkscape_mcp.sh"
      ]
    }
  },
  "servers": {
    "inkscape-mcp": {
      "command": "python",
      "args": [
        "-m",
        "inkmcp.inkscape_mcp_server"
      ]
    }
  }
}